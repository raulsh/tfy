#!/usr/bin/env bash
# A stand-in for `claude -p` used by the runner tests. FAKE_MODE picks the
# behaviour; FAKE_FIXTURE is a recorded stream-json file to emit.
[ -n "$FAKE_ARGS_OUT" ] && printf '%s\n' "$@" > "$FAKE_ARGS_OUT"
stdin=$(cat)
[ -n "$FAKE_STDIN_OUT" ] && printf '%s' "$stdin" > "$FAKE_STDIN_OUT"

interrupted_result='{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":1,"total_cost_usd":0.01,"session_id":"fake","permission_denials":[]}'

case "$FAKE_MODE" in
  replay)
    cat "$FAKE_FIXTURE" ;;
  noise)
    echo "not json at all"
    cat "$FAKE_FIXTURE" ;;
  linger)
    # The result is out, but the process keeps waiting (background tasks).
    cat "$FAKE_FIXTURE"
    trap 'exit 0' INT
    while :; do sleep 0.1; done ;;
  hang)
    # Mid-run; SIGINT yields an error result and exit 0, like the real CLI.
    trap 'echo "$interrupted_result"; exit 0' INT
    head -n 3 "$FAKE_FIXTURE"
    while :; do sleep 0.1; done ;;
  ignore-int)
    trap '' INT
    head -n 1 "$FAKE_FIXTURE"
    while :; do sleep 0.1; done ;;
  resume-slowly)
    # A session with sub-agents resumes after a result, for another turn
    # that takes FAKE_PAUSE seconds before its first message.
    seen_result=
    while IFS= read -r line; do
      printf '%s\n' "$line"
      case "$line" in
        '{"type":"assistant"'*|'{"type":"user"'*) ;;
        *'"type":"result"'*) seen_result=1 ;;
        '{"type":"system","subtype":"init"'*) [ -n "$seen_result" ] && sleep "${FAKE_PAUSE:-0.5}" ;;
      esac
    done < "$FAKE_FIXTURE" ;;
  fail)
    echo "boom: something broke" >&2
    exit 3 ;;
esac
